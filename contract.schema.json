{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/agentdeal/v0.1/contract.schema.json",
  "title": "AgentDeal Contract v0.1",
  "type": "object",
  "required": ["agentdeal_version", "contract_id", "created", "parties", "subject", "price", "deadline", "criteria", "remedy", "notary"],
  "properties": {
    "agentdeal_version": { "const": "0.1" },
    "contract_id": { "type": "string", "format": "uuid" },
    "created": { "type": "string", "format": "date-time" },
    "deadline": { "type": "string", "format": "date-time" },
    "dispute_window_hours": { "type": "integer", "minimum": 1, "default": 24 },
    "parties": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": { "$ref": "#/$defs/party" }
    },
    "subject": { "type": "string", "minLength": 10 },
    "price": {
      "type": "object",
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "payment_mandate_ref": { "type": "string" }
      },
      "additionalProperties": false
    },
    "criteria": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/criterion" }
    },
    "remedy": {
      "type": "object",
      "required": ["description", "refund_pct_if_nonconforming"],
      "properties": {
        "description": { "type": "string" },
        "refund_pct_if_nonconforming": { "type": "integer", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "notary": {
      "type": "object",
      "required": ["id", "public_key"],
      "properties": {
        "id": { "type": "string" },
        "public_key": { "type": "string", "minLength": 20 }
      },
      "additionalProperties": false
    },
    "signatures": {
      "type": "array",
      "items": { "$ref": "#/$defs/signature" }
    }
  },
  "$defs": {
    "party": {
      "type": "object",
      "required": ["id", "role", "organization", "public_key"],
      "properties": {
        "id": { "type": "string" },
        "role": { "enum": ["buyer", "seller"] },
        "organization": { "type": "string" },
        "agent_card_url": { "type": "string", "format": "uri" },
        "public_key": { "type": "string", "minLength": 20 }
      },
      "additionalProperties": false
    },
    "criterion": {
      "type": "object",
      "required": ["id", "text", "verification"],
      "properties": {
        "id": { "type": "string", "pattern": "^C[0-9]+$" },
        "text": { "type": "string", "minLength": 5 },
        "verification": { "enum": ["automated", "independent_verifier", "human"] }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "required": ["signer", "alg", "value"],
      "properties": {
        "signer": { "type": "string" },
        "alg": { "const": "Ed25519" },
        "value": { "type": "string", "minLength": 20 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
